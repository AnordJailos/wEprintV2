# ---------------------------------------------------------------- database ---
# Full read/write credential. The backend is the ONLY writer (decision D-5).
DATABASE_URL=postgres://printshop:printshop@localhost:5432/printshop

# ------------------------------------------------------------------- tokens ---
# 32+ random characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------ server ---
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# Comma separated list. "*" is refused in production on purpose.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------- ai service ---
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret the backend sends as x-internal-key; the AI service requires it.
INTERNAL_API_KEY=change-me-internal-shared-secret

# ------------------------------------------------------------------ uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400

# ---------------------------------------------------------- studio contact ---
STUDIO_WHATSAPP_NUMBER=255700000000

# --------------------------------------------------- one-time admin seeding ---
ADMIN_NAME=AK Admin
ADMIN_EMAIL=admin@aktimetoshine.com
ADMIN_PASSWORD=change-this-admin-password
