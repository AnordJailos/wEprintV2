# ------------------------------------------------------------------ binding ---
# NEVER 0.0.0.0 in production (decision D-6): only the backend may reach this.
AI_HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------- database ---
# READ-ONLY credential (decision D-4). This service never writes; the backend
# performs every INSERT, including the vectors this service computes (D-5).
AI_DATABASE_URL=postgres://printshop_ai:printshop_ai@localhost:5432/printshop

# ------------------------------------------------------------------ secret ---
# Must match the backend's INTERNAL_API_KEY exactly. Sent as x-internal-key.
INTERNAL_API_KEY=change-me-internal-shared-secret

# ---------------------------------------------------------------- retrieval ---
# Chunk size in words and the cosine-distance cutoff. 0.7 keeps loose matches out.
CHUNK_WORDS=150
CHUNK_OVERLAP_WORDS=25
MAX_DISTANCE=0.7
TOP_K=5

# ---------------------------------------------------------------- embedding ---
# 384-dimension model; must match the vector(384) column in the schema.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Where the model files are cached on disk (first run downloads ~90MB).
TRANSFORMERS_CACHE=./.model-cache

# ------------------------------------------------------- answer generation ---
# Optional. Any OpenAI-compatible Responses API endpoint.
#
# RECOMMENDED (free, zero external accounts): the Lovable AI Gateway.
#   LLM_API_URL=https://ai.gateway.lovable.dev/v1
#   LLM_API_KEY=<your LOVABLE_API_KEY>   (or set LOVABLE_API_KEY directly)
#   LLM_MODEL=openai/gpt-5.6-sol
#
# NOTE: Grok (xAI) is NOT free — it bills per token. The gateway above is the
# free path. GPT-5.6 models use the Responses API (this service already does).
#
# Leave LLM_API_URL empty and the service answers extractively from the
# retrieved passages only — grounded, just less conversational.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=openai/gpt-5.6-sol
